<mvc:View controllerName="skillfinder.controller.user.CVPreview" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m"><Page title="Mon CV" showNavButton="true" navButtonPress=".router().navTo('userDashboard')"><content><VBox class="cvSheet"><Title text="{cv>/user/displayName}"/><Text text="{cv>/jobTitle}"/><Title text="Profil" level="H3"/><Text text="{cv>/professionalSummary}"/><Title text="Compétences" level="H3"/><List items="{cv>/skills}"><StandardListItem title="{cv>name}" description="{cv>level} - {cv>experienceYears} ans"/></List><Title text="Expériences" level="H3"/><List items="{cv>/experiences}"><StandardListItem title="{cv>title}" description="{cv>company} - {cv>technologies}"/></List><Title text="Formations" level="H3"/><List items="{cv>/educations}"><StandardListItem title="{cv>degree}" description="{cv>institution}"/></List><Title text="Certifications" level="H3"/><List items="{cv>/certifications}"><StandardListItem title="{cv>name}" description="{cv>issuer}"/></List><Button text="Générer et télécharger" type="Emphasized" press="generate"/></VBox></content></Page></mvc:View>