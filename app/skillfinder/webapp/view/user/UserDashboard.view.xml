<mvc:View controllerName="skillfinder.controller.user.UserDashboard" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f"><Page title="SkillFinder" class="sfPage"><customHeader><Bar><contentLeft><Title text="SkillFinder"/></contentLeft><contentMiddle><Button text="Tableau de bord" data-route="userDashboard" press="go"/><Button text="Mon Profil" data-route="profile" press="go"/><Button text="Mon CV" data-route="cvPreview" press="go"/></contentMiddle><contentRight><Text text="{session>/user/displayName}"/><Button icon="sap-icon://log" press="logout" tooltip="Déconnexion"/></contentRight></Bar></customHeader><content><VBox class="pageContent"><Title text="Bienvenue, {session>/user/displayName} !"/><Text text="Voici un aperçu de votre profil."/><HBox wrap="Wrap" class="cards"><GenericTile header="Compétences" subheader="Voir détails" press="go" data-route="skills"><TileContent><NumericContent value="{= ${profile>/skills}.length }" icon="sap-icon://competitor"/></TileContent></GenericTile><GenericTile header="Certifications" subheader="Voir détails" press="go" data-route="certifications"><TileContent><NumericContent value="{= ${profile>/certifications}.length }" icon="sap-icon://badge"/></TileContent></GenericTile><GenericTile header="Formations" subheader="Voir détails" press="go" data-route="educations"><TileContent><NumericContent value="{= ${profile>/educations}.length }" icon="sap-icon://study-leave"/></TileContent></GenericTile><GenericTile header="CV" subheader="Généré" press="go" data-route="cvPreview"><TileContent><NumericContent value="{= ${profile>/cvs}.length }" icon="sap-icon://document-text"/></TileContent></GenericTile></HBox><Panel headerText="Informations générales"><ObjectHeader title="{profile>/user/displayName}" intro="{profile>/jobTitle}" number="{profile>/totalExperienceYears}" numberUnit="années"><attributes><ObjectAttribute title="Email" text="{profile>/user/email}"/><ObjectAttribute title="Département" text="{profile>/department}"/><ObjectAttribute title="Localisation" text="{profile>/location}"/></attributes></ObjectHeader><Text text="{profile>/professionalSummary}"/></Panel><Panel headerText="Compétences principales"><Table items="{profile>/skills}"><columns><Column><Text text="Compétence"/></Column><Column><Text text="Niveau"/></Column><Column><Text text="Années"/></Column></columns><items><ColumnListItem><cells><Text text="{profile>name}"/><ObjectStatus text="{profile>level}" state="Success"/><Text text="{profile>experienceYears}"/></cells></ColumnListItem></items></Table></Panel></VBox></content></Page></mvc:View>